# Tribune Breizh (breizh.tribuneouest.fr)
# HTTPS obligatoire
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Ouverture : tout passe par gate.php (page d'attente avant l'heure, vrai site ensuite), jamais d'accès direct à index.html
RewriteRule ^index\.html$ / [R=302,L]

# Le dépôt Git et les fichiers techniques ne sont jamais servis
RedirectMatch 404 /\.git
RedirectMatch 404 ^/bot/
RedirectMatch 404 ^/(src|cache)/
<FilesMatch "^(build\.py|README\.md|deploy\.sh)$">
  Require all denied
</FilesMatch>

# La page change chaque jour : le navigateur doit toujours vérifier la dernière version
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

DirectoryIndex gate.php index.html
ErrorDocument 404 /gate.php

# Polices : mises en cache un an
AddType font/woff .woff
<FilesMatch "\.(woff|png)$">
  Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# Images Instagram : servies telles quelles (JPEG)
AddType image/jpeg .jpg
